RewriteEngine On

# use for authentication

RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f

Header set Access-Control-Allow-Origin *

RewriteRule ^upload-photo$ core/upload-photo.php [L]
RewriteRule ^upload-multiple-photo$ core/upload-multiple-photo.php [L]

### Settings - Roles ###
RewriteRule ^role$ controllers/developer/settings/role/role.php [L]
RewriteRule ^role/([0-9]+)$ controllers/developer/settings/role/role.php?roleid=$1 [L]
RewriteRule ^role/active/([0-9]+)$ controllers/developer/settings/role/active.php?roleid=$1 [L]
RewriteRule ^role/search$ controllers/developer/settings/role/search.php [L]
RewriteRule ^role/page/([0-9]+)$ controllers/developer/settings/role/page.php?start=$1 [L]

### Settings - USER ###
RewriteRule ^user$ controllers/developer/settings/user/user.php [L]
RewriteRule ^user/([0-9]+)$ controllers/developer/settings/user/user.php?userid=$1 [L]
RewriteRule ^user/page/([0-9]+)$ controllers/developer/settings/user/page.php?start=$1 [L]
RewriteRule ^user/search$ controllers/developer/settings/user/search.php [L]
RewriteRule ^user/active/([0-9]+)$ controllers/developer/settings/user/active.php?userid=$1 [L]
RewriteRule ^user/verify-email/(.*)$ controllers/developer/settings/user/update-email.php?userkey=$1 [L]
RewriteRule ^user/key/(.*)$ controllers/developer/settings/user/key.php?userkey=$1 [L]
RewriteRule ^user/password$ controllers/developer/settings/user/set-password.php [L]
RewriteRule ^user/login$ controllers/developer/settings/user/login.php [L]
RewriteRule ^user/token$ controllers/developer/settings/user/token.php [L]
RewriteRule ^user/reset$ controllers/developer/settings/user/reset-password.php [L]
RewriteRule ^user/role$ controllers/developer/settings/user/role.php [L] 

# HEADER
RewriteRule ^header$ controllers/developer/header/header.php [L]
RewriteRule ^header/([0-9]+)$ controllers/developer/header/header.php?headerid=$1 [L]

# ABOUT
RewriteRule ^about$ controllers/developer/about/about.php [L]
RewriteRule ^about/([0-9]+)$ controllers/developer/about/about.php?aboutid=$1 [L]

# SERVICES
RewriteRule ^services$ controllers/developer/services/services.php [L]
RewriteRule ^services/([0-9]+)$ controllers/developer/services/services.php?servicesid=$1 [L]

# CONTACT US
RewriteRule ^contactUs$ controllers/developer/contact-us/contactUs.php [L]
RewriteRule ^contactUs/([0-9]+)$ controllers/developer/contact-us/contactUs.php?contactUsid=$1 [L]

# REACH US
RewriteRule ^reachUs$ controllers/developer/reach-us/reachUs.php [L]
RewriteRule ^reachUs/([0-9]+)$ controllers/developer/reach-us/reachUs.php?reachUsid=$1 [L]

# COPYRIGHT
RewriteRule ^copyright$ controllers/developer/copyright/copyright.php [L]
RewriteRule ^copyright/([0-9]+)$ controllers/developer/copyright/copyright.php?copyrightid=$1 [L]

# TESTIMONIAL
RewriteRule ^testimonial$ controllers/developer/testimonial/testimonial.php [L]
RewriteRule ^testimonial/([0-9]+)$ controllers/developer/testimonial/testimonial.php?testimonialid=$1 [L]

# COLORS
RewriteRule ^colors$ controllers/developer/colors/colors.php [L]
RewriteRule ^colors/([0-9]+)$ controllers/developer/colors/colors.php?colorsid=$1 [L]
